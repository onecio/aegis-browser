AEGIS_GATEWAY_HOST=127.0.0.1
AEGIS_GATEWAY_PORT=8787
AEGIS_GATEWAY_ISSUER=https://identity.example.org/
AEGIS_GATEWAY_JWKS_URL=https://identity.example.org/.well-known/jwks.json
AEGIS_GATEWAY_AUDIENCE=aegis-browser
AEGIS_GATEWAY_REQUIRED_SCOPE=aegis.analyze
AEGIS_GATEWAY_ALLOWED_ORIGINS=chrome-extension://replace-with-published-extension-id
AEGIS_GATEWAY_ALLOWED_TENANTS=replace-with-approved-organization-id
AEGIS_GATEWAY_RPM=30
TYPESAFE_MODEL=jev-latest
# Configure TYPESAFE_API_KEY in the host secret manager. Never put its value in this file.
